{
  "name": "paper-reader",
  "productName": "Paper Reader",
  "version": "0.1.0",
  "description": "本地论文管理与阅读器（AI 协作）",
  "author": "Paper Reader",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/start-prod.js",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.paperreader.app",
    "productName": "Paper Reader",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "node_modules/pdfjs-dist/**"
    ],
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!node_modules/pdfjs-dist/{image_decoders,legacy/image_decoders}/**",
      "!node_modules/katex/{contrib,src,dist/contrib}/**",
      "!**/{test,tests,__tests__,example,examples,docs}/**",
      "!client/**",
      "!data/**",
      "!release/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PaperReader-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Paper Reader"
    },
    "portable": {
      "artifactName": "PaperReader-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "katex": "0.18.3",
    "linkedom": "0.18.13",
    "marked": "18.1.1",
    "marked-katex-extension": "5.1.13",
    "multer": "2.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  }
}
